{{!
    @template mod_interactiveslide/presenter

    The presenter console: filmstrip, stage, overlay and transport controls.

    Example context (json):
    {
        "cmid": 12,
        "name": "Chuong 3",
        "viewurl": "#"
    }
}}
<div class="islide-present" data-region="interactiveslide-present" data-cmid="{{cmid}}">

    <header class="islide-present-bar">
        <div class="islide-present-left">
            <a class="islide-icon-btn" href="{{viewurl}}" title="{{#str}}backtoactivity, mod_interactiveslide{{/str}}">
                <span aria-hidden="true">&#8592;</span>
                <span class="islide-sr-only">{{#str}}backtoactivity, mod_interactiveslide{{/str}}</span>
            </a>
            <span class="islide-present-name">{{name}}</span>
        </div>

        <div class="islide-present-center" data-region="sessioninfo" hidden>
            <span class="islide-live-dot" aria-hidden="true"></span>
            <span class="islide-present-code" data-region="joincode"></span>
            <span class="islide-present-online" data-region="onlinecount"></span>
        </div>

        <div class="islide-present-right">
            <button type="button" class="btn btn-primary" data-action="startsession">
                {{#str}}startsession, mod_interactiveslide{{/str}}
            </button>
            <button type="button" class="btn btn-outline-danger" data-action="endsession" hidden>
                {{#str}}endsession, mod_interactiveslide{{/str}}
            </button>
            <button type="button" class="islide-icon-btn" data-action="fullscreen"
                    title="{{#str}}fullscreen, mod_interactiveslide{{/str}}">
                <span aria-hidden="true">&#9974;</span>
                <span class="islide-sr-only">{{#str}}fullscreen, mod_interactiveslide{{/str}}</span>
            </button>
        </div>
    </header>

    <div class="islide-present-body">

        <aside class="islide-filmstrip" data-region="filmstrip" aria-label="{{#str}}slides, mod_interactiveslide{{/str}}"></aside>

        <main class="islide-present-main">
            <div class="islide-stage islide-stage-present" data-region="stage">
                <figure class="islide-stage-image" hidden>
                    <img data-region="slideimage" src="" alt="{{#str}}currentslide, mod_interactiveslide{{/str}}">
                </figure>

                <div class="islide-stage-placeholder" data-region="stageplaceholder">
                    <span class="islide-stage-placeholder-icon" aria-hidden="true">&#9654;</span>
                    <h2 data-region="placeholder-title">{{#str}}nosessionyet, mod_interactiveslide{{/str}}</h2>
                    <p data-region="placeholder-text">{{#str}}nosessionyet_desc, mod_interactiveslide{{/str}}</p>
                </div>

                <button type="button" class="islide-start-badge" data-action="openround" hidden>
                    <span class="islide-start-badge-icon" aria-hidden="true">&#9654;</span>
                    <span class="islide-start-badge-label">{{#str}}startinteraction, mod_interactiveslide{{/str}}</span>
                </button>

                <div class="islide-annotate-layer" data-region="annotate-layer" data-tool="off">
                    <canvas data-region="annotate-ink"></canvas>
                    <canvas data-region="annotate-laser"></canvas>
                </div>

                <div class="islide-annotate" data-region="annotate">
                    <div class="islide-annotate-tools">
                        <button type="button" class="islide-annotate-btn" data-annotate-tool="off"
                                aria-pressed="true" title="{{#str}}annotateoff, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#9166;</span>
                            <span class="islide-sr-only">{{#str}}annotateoff, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-btn" data-annotate-tool="laser"
                                aria-pressed="false" title="{{#str}}annotatelaser, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#9673;</span>
                            <span class="islide-sr-only">{{#str}}annotatelaser, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-btn" data-annotate-tool="pen"
                                aria-pressed="false" title="{{#str}}annotatepen, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#9998;</span>
                            <span class="islide-sr-only">{{#str}}annotatepen, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-btn" data-annotate-tool="highlight"
                                aria-pressed="false" title="{{#str}}annotatehighlight, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#9646;</span>
                            <span class="islide-sr-only">{{#str}}annotatehighlight, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-btn" data-annotate-tool="eraser"
                                aria-pressed="false" title="{{#str}}annotateeraser, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#9003;</span>
                            <span class="islide-sr-only">{{#str}}annotateeraser, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-btn" data-annotate-action="stylusonly"
                                aria-pressed="false"
                                title="{{#str}}annotatestylusonly, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#9997;</span>
                            <span class="islide-sr-only">{{#str}}annotatestylusonly, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-btn islide-annotate-clear"
                                data-annotate-action="clear"
                                title="{{#str}}annotateclear, mod_interactiveslide{{/str}}">
                            <span aria-hidden="true">&#128465;</span>
                            <span class="islide-sr-only">{{#str}}annotateclear, mod_interactiveslide{{/str}}</span>
                        </button>
                    </div>

                    <div class="islide-annotate-options" data-region="annotate-options-laser" hidden>
                        <button type="button" class="islide-annotate-chip" data-annotate-set="lasermode"
                                data-annotate-value="dot" aria-pressed="true">
                            {{#str}}annotatelaserdot, mod_interactiveslide{{/str}}
                        </button>
                        <button type="button" class="islide-annotate-chip" data-annotate-set="lasermode"
                                data-annotate-value="line" aria-pressed="false">
                            {{#str}}annotatelaserline, mod_interactiveslide{{/str}}
                        </button>
                    </div>

                    <div class="islide-annotate-options" data-region="annotate-options-pen" hidden>
                        <button type="button" class="islide-annotate-swatch" data-annotate-set="pencolour"
                                data-annotate-value="#2563eb" style="--islide-swatch: #2563eb"
                                aria-pressed="true" title="{{#str}}colourblue, mod_interactiveslide{{/str}}">
                            <span class="islide-sr-only">{{#str}}colourblue, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-swatch" data-annotate-set="pencolour"
                                data-annotate-value="#dc2626" style="--islide-swatch: #dc2626"
                                aria-pressed="false" title="{{#str}}colourred, mod_interactiveslide{{/str}}">
                            <span class="islide-sr-only">{{#str}}colourred, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-swatch" data-annotate-set="pencolour"
                                data-annotate-value="#f59e0b" style="--islide-swatch: #f59e0b"
                                aria-pressed="false" title="{{#str}}colouryellow, mod_interactiveslide{{/str}}">
                            <span class="islide-sr-only">{{#str}}colouryellow, mod_interactiveslide{{/str}}</span>
                        </button>
                        <span class="islide-annotate-divider" aria-hidden="true"></span>
                        <button type="button" class="islide-annotate-nib" data-annotate-set="penwidth"
                                data-annotate-value="2" aria-pressed="false"
                                title="{{#str}}annotatethin, mod_interactiveslide{{/str}}">
                            <span class="islide-annotate-nib-dot" style="--islide-nib: 4px"></span>
                            <span class="islide-sr-only">{{#str}}annotatethin, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-nib" data-annotate-set="penwidth"
                                data-annotate-value="4" aria-pressed="true"
                                title="{{#str}}annotatemedium, mod_interactiveslide{{/str}}">
                            <span class="islide-annotate-nib-dot" style="--islide-nib: 8px"></span>
                            <span class="islide-sr-only">{{#str}}annotatemedium, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-nib" data-annotate-set="penwidth"
                                data-annotate-value="8" aria-pressed="false"
                                title="{{#str}}annotatethick, mod_interactiveslide{{/str}}">
                            <span class="islide-annotate-nib-dot" style="--islide-nib: 13px"></span>
                            <span class="islide-sr-only">{{#str}}annotatethick, mod_interactiveslide{{/str}}</span>
                        </button>
                    </div>

                    <div class="islide-annotate-options" data-region="annotate-options-highlight" hidden>
                        <button type="button" class="islide-annotate-swatch" data-annotate-set="highlightcolour"
                                data-annotate-value="#fde047" style="--islide-swatch: #fde047"
                                aria-pressed="true" title="{{#str}}colouryellow, mod_interactiveslide{{/str}}">
                            <span class="islide-sr-only">{{#str}}colouryellow, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-swatch" data-annotate-set="highlightcolour"
                                data-annotate-value="#86efac" style="--islide-swatch: #86efac"
                                aria-pressed="false" title="{{#str}}colourgreen, mod_interactiveslide{{/str}}">
                            <span class="islide-sr-only">{{#str}}colourgreen, mod_interactiveslide{{/str}}</span>
                        </button>
                        <button type="button" class="islide-annotate-swatch" data-annotate-set="highlightcolour"
                                data-annotate-value="#f9a8d4" style="--islide-swatch: #f9a8d4"
                                aria-pressed="false" title="{{#str}}colourpink, mod_interactiveslide{{/str}}">
                            <span class="islide-sr-only">{{#str}}colourpink, mod_interactiveslide{{/str}}</span>
                        </button>
                    </div>
                </div>

                <div class="islide-overlay" data-region="overlay" hidden>
                    <div class="islide-overlay-head">
                        <h2 class="islide-overlay-question" data-region="overlay-question"></h2>
                        <div class="islide-overlay-meta">
                            <span class="islide-overlay-count" data-region="overlay-count"></span>
                            <div class="islide-timer islide-timer-lg" data-region="timer" hidden>
                                <svg class="islide-timer-ring" viewBox="0 0 44 44" aria-hidden="true">
                                    <circle class="islide-timer-track" cx="22" cy="22" r="19"></circle>
                                    <circle class="islide-timer-fill" cx="22" cy="22" r="19" data-region="timer-arc"></circle>
                                </svg>
                                <span class="islide-timer-value" data-region="timer-value">0</span>
                            </div>
                            <button type="button" class="islide-icon-btn" data-action="closeoverlay"
                                    title="{{#str}}hideoverlay, mod_interactiveslide{{/str}}">
                                <span aria-hidden="true">&#10005;</span>
                                <span class="islide-sr-only">{{#str}}hideoverlay, mod_interactiveslide{{/str}}</span>
                            </button>
                        </div>
                    </div>

                    <div class="islide-overlay-body" data-region="overlay-body"></div>

                    <div class="islide-overlay-board" data-region="overlay-board" hidden></div>
                </div>
            </div>

            <div class="islide-transport">
                <button type="button" class="islide-icon-btn" data-action="prev"
                        title="{{#str}}previousslide, mod_interactiveslide{{/str}}">
                    <span aria-hidden="true">&#8249;</span>
                    <span class="islide-sr-only">{{#str}}previousslide, mod_interactiveslide{{/str}}</span>
                </button>

                <span class="islide-transport-position" data-region="slideposition">0 / 0</span>

                <button type="button" class="islide-icon-btn" data-action="next"
                        title="{{#str}}nextslide, mod_interactiveslide{{/str}}">
                    <span aria-hidden="true">&#8250;</span>
                    <span class="islide-sr-only">{{#str}}nextslide, mod_interactiveslide{{/str}}</span>
                </button>

                <div class="islide-transport-actions" data-region="roundactions">
                    <button type="button" class="btn btn-primary" data-action="openround" hidden>
                        {{#str}}startinteraction, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-action="closeround" hidden>
                        {{#str}}stopcollecting, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-success" data-action="reveal" hidden>
                        {{#str}}revealanswer, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-action="hide" hidden>
                        {{#str}}hideanswer, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-action="showresult" hidden>
                        {{#str}}pushresult, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-action="hideresult" hidden>
                        {{#str}}hideresult, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-action="reset" hidden>
                        {{#str}}resetround, mod_interactiveslide{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-action="toggleoverlay" hidden>
                        <span data-region="toggleoverlay-label">{{#str}}showresultscreen, mod_interactiveslide{{/str}}</span>
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-action="toggleboard">
                        {{#str}}leaderboard, mod_interactiveslide{{/str}}
                    </button>
                </div>
            </div>
        </main>
    </div>

    <div class="islide-toast" data-region="toast" role="status" aria-live="polite" hidden></div>
</div>
